# ── NETWORK ─────────────────────────────────────────────────
# Host IP for the published api port. 0.0.0.0 listens on all
# interfaces so other machines can reach the gateway; set 127.0.0.1
# for same-host-only use, or a specific LAN IP to pin an interface.
# The gateway requires API_KEY auth, but still keep it off untrusted
# networks (firewall it if the host is internet-facing).
INFRA_BIND_IP=0.0.0.0

# ── API GATEWAY ─────────────────────────────────────────────
# Bearer token required on every /v1/* request. Clients must use this same key.
# ./infra.sh fills this in with a fresh random key when it creates .env; if you
# copy this file by hand, generate one yourself: openssl rand -hex 32
# Left empty on purpose — the gateway refuses to start rather than run unsecured.
API_KEY=

# Where the gateway proxies chat completions:
#   local  -> the bundled Ollama
#   remote -> an OpenAI-compatible endpoint (LLM_URL + LLM_API_TOKEN)
LLM_PROVIDER=local
LLM_THINKING=false
LLM_NUM_CTX=65536
LLM_URL=
LLM_API_TOKEN=

# Timeout budget for gateway -> upstream LLM/TTS/STT/image requests (seconds).
BACKEND_UPSTREAM_TIMEOUT_SECONDS=900

# ── OLLAMA (LLM + embeddings) ───────────────────────────────
# Space-separated list of models pulled on first start by ollama-init.
# tev1 (4B) and nimble (9B) are decision models for /v1/systemone (needs Ollama >= 0.35).
OLLAMA_PULL_MODELS="gemma4:12b snowflake-arctic-embed:137m tev1 nimble"

# ── FEATURE TOGGLES (compose profiles) ──────────────────────
# Enabled services besides ollama. Start with:
#   docker compose --profile stt --profile tts --profile imagegen up -d
# or use ./infra.sh which reads these flags.
ENABLE_STT=true
ENABLE_TTS=true
ENABLE_IMAGEGEN=true
# Vocal/stem separation (Demucs). Off by default: heavier image, shares the GPU.
ENABLE_SEPARATION=false

# ── STT (Whisper) ───────────────────────────────────────────
# tiny | base | small | medium | large-v3 | large-v3-turbo (+ .en variants)
# large-v3-turbo beats medium on accuracy and speed at lower VRAM (~1.6 GB).
WHISPER_MODEL=large-v3-turbo
# Interim hypotheses on the streaming WS: re-decode the open segment when this
# much new audio has arrived (ms). 0 disables partials.
WHISPER_PARTIAL_MS=600

# ── TTS (KittenTTS) ─────────────────────────────────────────
TTS_MODEL=KittenML/kitten-tts-nano-0.8

# ── IMAGE GENERATION (Krea 2) ───────────────────────────────
# krea2-turbo (8-step distillate, default) or krea2-raw (28 steps, CFG 4.5).
# All weights come from ungated repos (Comfy-Org/Krea-2 transformer, stock Qwen
# text encoder + VAE): no HuggingFace token needed. The Krea 2 Community License
# still applies to the weights.
IMAGEGEN_MODEL=krea2-turbo
# 1 = ComfyUI's pre-scaled fp8 transformer (~13 GB) so it fits a 24 GB GPU;
# 0 = the bf16 transformer (~26 GB, needs a ~32 GB+ GPU).
IMAGEGEN_FP8=1
# Leave empty to use the checkpoint's own defaults (Turbo 8 / 0.0, Raw 28 / 4.5).
IMAGEGEN_STEPS=
IMAGEGEN_GUIDANCE=
# Reference images (/v1/images/edits) only work through a LoRA trained on them:
# base Krea 2 garbles them into mosaic blocks. Each reference_mode needs its
# LoRA ("repo:weight_file"); empty disables that mode.
# style: render the prompt in the reference's style (default, on).
IMAGEGEN_STYLE_LORA=ostris/krea2_turbo_style_reference:krea2_style_reference.safetensors
# edit: subject reference / edits ("the same dog in a space suit"). No general
# Krea 2 edit LoRA is published yet; train one with ostris AI Toolkit's Krea 2
# reference-image trainer and point this at it to enable edit mode.
IMAGEGEN_EDIT_LORA=
# Offline mode: never reach the network for weights. A cached model loads; a
# missing one errors immediately instead of hanging. Pre-download models first
# with ./infra.sh pull-models (or one online start).
IMAGEGEN_OFFLINE=0

# ── SOURCE SEPARATION (Demucs) ──────────────────────────────
# htdemucs (default) | htdemucs_ft (finer, 4x slower) | mdx_extra_q (lighter)
DEMUCS_MODEL=htdemucs
# Optional per-inference chunk seconds; unset = model default (htdemucs: 7.8, its max).
#DEMUCS_SEGMENT=

# ── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=INFO
